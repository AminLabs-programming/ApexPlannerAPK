```gitignore
# Compiled and build artifacts
*.pyc
__pycache__/
*.o
*.obj
*.class
*.exe
*.dll
*.so
*.a
*.out

# Dependencies
node_modules/
venv/
.venv/
.env
.env.local
.env.*

# Build directories
dist/
build/
target/
*.jar
*.war
*.zip
*.tar.gz
*.tgz
*.rar
*.7z

# Logs and temporary files
*.log
*.tmp
*.swp
*.swo
*.bak
*.~*

# Coverage reports
coverage/
htmlcov/
.coverage

# IDE specific
.vscode/
.idea/
*.iml
*.ipr
*.iws

# OS specific
.DS_Store
Thumbs.db

# Cache directories
.mypy_cache/
.pytest_cache/
.gradle/
.cargo/
.npm/
.yarn/

# Compressed files
*.gz
*.tar
*.bz2
*.xz
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
```